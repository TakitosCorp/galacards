<!DOCTYPE html>
<html lang="en">
<%- include('components/head') %>

<link rel="stylesheet" href="/public/css/vid.css">

<body class="min-h-screen p-6 md:p-8 flex flex-col items-center justify-center">
  <video id="background-video" autoplay muted loop playbackRate="0.5">
    <source src="/public/vids/bg.webm" type="video/webm">
    Your browser does not support the video tag.
  </video>

  <h1 class="text-5xl md:text-6xl text-white font-bold mb-10 animate-glow tracking-wider"><%= gameTitle %> - VTuber List</h1>

  <div class="w-full max-w-7xl h-[70vh] mx-auto rounded-2xl shadow-2xl overflow-y-auto backdrop-blur-sm bg-purple-bg/40 p-6 md:p-8">
    <div id="cardGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 w-full">
      <!-- Cards will be rendered here dynamically -->
    </div>
  </div>

  <script src="/public/js/list.js"></script>
  <%- include('components/scripts') %>
</body>

</html>